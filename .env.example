NODE_ENV=development
PORT=3000

# Secret used to sign/verify JWTs. Generate a strong random value; never commit real secrets.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1h

# Path to the SQLite database file.
DATABASE_FILE=./data/taskbridge.sqlite

# One of: error, warn, info, http, debug
LOG_LEVEL=info
