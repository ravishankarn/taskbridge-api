NODE_ENV=development
PORT=3000

# Secret used to sign/verify JWTs. Generate a strong random value; never commit real secrets.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1h

# Path to the SQLite database file.
DATABASE_FILE=./data/taskbridge.sqlite

# One of: error, warn, info, http, debug
LOG_LEVEL=info

# Background processing that drains the milestone outbox into audit_events and fans
# audited events out to in-app notifications. Disable to run the API without workers.
NOTIFICATION_PROCESSING_ENABLED=true
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_BATCH_SIZE=100
